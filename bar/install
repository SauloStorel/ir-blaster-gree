#!/usr/bin/env bash
# Instala (ou atualiza) o plugin na barra do Omarchy, que não aceita links simbólicos.
set -euo pipefail

src=$(dirname "$(realpath "$0")")
dest="$HOME/.config/omarchy/plugins/storell.xfria"

mkdir -p "$dest"
cp "$src"/{manifest.json,BarWidget.qml,Model.js,xfria} "$dest"/
omarchy plugin validate "$dest"

# A recarga automática do plugin pode deixar a versão antiga recebendo os cliques.
omarchy restart shell
