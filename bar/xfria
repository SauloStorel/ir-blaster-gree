#!/usr/bin/env bash
# Fala com o ar-condicionado pelo Adafruit IO.
#
#   xfria watch            imprime "state <json>" e "online <online|offline>" a cada mudança
#   xfria send '<json>'    envia um comando, ex.: xfria send '{"power": true, "temp": 22}'
#   xfria simulate         finge ser o ESP32, para testar sem a placa
#
# Credenciais em ~/.config/xfria/credentials (AIO_USERNAME e AIO_KEY).
set -euo pipefail

source "${XDG_CONFIG_HOME:-$HOME/.config}/xfria/credentials"

readonly FEEDS="$AIO_USERNAME/feeds/ar-quarto"
readonly MQTT=(-h io.adafruit.com -p 8883 --cafile /etc/ssl/certs/DigiCert_Global_Root_G2.pem
  -u "$AIO_USERNAME" -P "$AIO_KEY")

publish() { mosquitto_pub "${MQTT[@]}" -t "$FEEDS-$1" -m "$2"; }

# O Adafruit IO não tem retain, então o último valor vem da API REST.
print_last() {
  curl -fsS --max-time 10 -H "X-AIO-Key: $AIO_KEY" \
    "https://io.adafruit.com/api/v2/$FEEDS-$1/data/last" | jq -r --arg feed "$1" '"\($feed) \(.value)"'
}

watch() {
  print_last state
  print_last online
  mosquitto_sub "${MQTT[@]}" -t "$FEEDS-state" -t "$FEEDS-online" -F '%t %p' | sed -u "s|^$FEEDS-||"
}

send() { publish set "$1"; }

simulate() {
  local state='{"power":false,"mode":"cool","temp":24,"fan":"auto","airflow":"swing","sleep":false,"eco":false,"turbo":false,"light":false}'

  trap 'publish online offline' EXIT
  publish online online
  publish state "$state"
  echo "Simulando o ESP32. Ctrl+C para parar."

  while read -r command; do
    state=$(jq -c --argjson cmd "$command" '. + $cmd | .temp |= ([16, ., 30] | sort | .[1])' <<<"$state") || continue
    echo "comando: $command → estado: $state"
    publish state "$state"
  done < <(mosquitto_sub "${MQTT[@]}" -t "$FEEDS-set")
}

case "${1:-}" in
  watch | simulate) "$1" ;;
  send) send "$2" ;;
  *) sed -n '2,7s/^# \{0,1\}//p' "$0" >&2 && exit 1 ;;
esac
